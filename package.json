{
  "name": "@captiveorigins/payload-plugin-supplies",
  "version": "0.1.0",
  "description": "Supplies for Payload: track what goes into the things you make, with suppliers, stock from an append-only movement log, recipes that use stock in one transaction, one low-stock email per drop and a reorder list.",
  "homepage": "https://github.com/CaptiveOrigins/payload-plugin-supplies#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/payload-plugin-supplies/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "inventory",
    "stock",
    "supplies",
    "bill-of-materials",
    "low-stock",
    "reorder",
    "multi-tenant"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaptiveOrigins/payload-plugin-supplies.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rsc": {
      "types": "./dist/rsc/index.d.ts",
      "import": "./dist/rsc/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "leak-check": "bash scripts/leak-check.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@payloadcms/next": "^3.80.0",
    "payload": "^3.80.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "next": "16.3.3",
    "payload": "3.92.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
